# ===== 高德（服务端 REST）=====
# 高德 Web服务 Key（服务端 REST 调用：地理编码、周边搜索、路线规划）
AMAP_WEB_KEY=

# 高德 JS API Key + 安全密钥（前端地图展示；当前地图为离线示意，暂未使用）
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# ===== DeepSeek（真实 LLM）=====
# 填入后 AI 协调助手走真实 DeepSeek；留空则使用离线 FakeLLM（测试/演示可断网）
DEEPSEEK_API_KEY=
# 可选：自定义端点与模型（默认如下）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 行为开关 =====
# 地理适配器：auto（有 AMAP_WEB_KEY 用真实高德，否则 Fake）/ fake / amap
FAIRMEET_GEO=auto
# SQLite 数据库路径（默认 ./fairmeet.db）
FAIRMEET_DB_PATH=
