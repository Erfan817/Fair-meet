# ===== 高德（服务端 REST）=====
# 高德 Web服务 Key（服务端 REST 调用：地理编码、周边搜索、路线规划）
AMAP_WEB_KEY=

# 高德 JS API Key + 安全密钥（前端地图展示；当前地图为离线示意，暂未使用）
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# ===== DeepSeek（真实 LLM）=====
# 填入后 AI 协调助手走真实 DeepSeek；留空则使用离线 FakeLLM（测试/演示可断网）
DEEPSEEK_API_KEY=
# 可选：自定义端点与模型（默认如下）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 行为开关 =====
# 地理适配器：auto（有 AMAP_WEB_KEY 用真实高德，否则 Fake）/ fake / amap
FAIRMEET_GEO=auto
# SQLite 数据库路径（默认 ./fairmeet.db）
FAIRMEET_DB_PATH=

# ===== 规划前资料检索（只有成员明确授权并点击才联网）=====
# 免密钥公开网页搜索：受上游验证/限流影响，不能承诺持续可用；遇限制停止本实例。
FAIRMEET_PUBLIC_SEARCH_ENABLED=1
FAIRMEET_PUBLIC_SEARCH_DAILY_LIMIT=20
# 高德地点发现（需已有真实 AMAP_WEB_KEY；不是点评/攻略，调用会消耗高德配额）
FAIRMEET_AMAP_SEARCH_DAILY_LIMIT=20
# Brave 为可选“搜索摘要”来源，不提供平台正文/评论，不是已验收的平台接口。
# 三项齐备 + 旅程成员明确开启联网，才允许调用。先独立核对条款/费用/可用性。
BRAVE_SEARCH_API_KEY=
FAIRMEET_RESEARCH_BRAVE_VERIFIED=0
# 每日真实搜索请求硬上限；0=禁用。不会因填 Key 自动产生费用。
FAIRMEET_RESEARCH_DAILY_LIMIT=0
